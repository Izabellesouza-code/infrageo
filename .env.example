# Copie para .env e ajuste antes do deploy:
#   copy .env.example .env

# production | development
INFRAGEO_ENV=production

# 0 = UI Flask + API (padrão, como antes). 1 = só API (UI no Vercel).
INFRAGEO_API_ONLY=0
INFRAGEO_FRONTEND_URL=https://infrageo-webgis.vercel.app
# Origens permitidas no CORS (vírgula). * libera todas.
CORS_ORIGINS=*

# Porta (local/Docker). No Render a plataforma define PORT automaticamente.
PORT=8000

# Escuta em todas as interfaces para abrir no celular/tablet na mesma Wi‑Fi.
# Use HOST=127.0.0.1 se quiser restringir só a este PC.
HOST=0.0.0.0

# Workers Gunicorn (leitura de SHP é CPU/RAM-bound; no Render Starter use 1)
WEB_CONCURRENCY=1

# Timeout em segundos para requisições longas (camadas grandes)
GUNICORN_TIMEOUT=180

# true = indexa shapefiles uma vez e compartilha entre workers (recomendado)
GUNICORN_PRELOAD=true

# 1 = warm-up de camadas em background (recomendado no Render para health check)
INFRAGEO_BG_WARMUP=1

# 1 = modo econômico de RAM (obrigatório no Render Free/Starter = 512 MB)
# Em Standard (2 GB+) pode desligar: INFRAGEO_LOW_MEMORY=0
INFRAGEO_LOW_MEMORY=1

# 1 = não pré-carrega Limite Estadual no startup (economiza RAM)
INFRAGEO_SKIP_LIMITE_WARMUP=1

# 1 = não indexa shapefiles no startup (índice sob demanda)
INFRAGEO_SKIP_INDEX=1

# Tolerância de simplify em graus (só com INFRAGEO_LOW_MEMORY=1)
INFRAGEO_SIMPLIFY_TOLERANCE=0.00035

# 1 = força warm-up síncrono no import (atrasa o bind da porta)
# INFRAGEO_BLOCKING_WARMUP=0

# 1 = pula indexação no startup (útil em dev com rede lenta)
# INFRAGEO_SKIP_INDEX=0

# Opcional: caminhos customizados de dados (volume montado)
# INFRAGEO_ASSETS_DIR=/data/assets
# INFRAGEO_UPLOADS_DIR=/data/uploads
# INFRAGEO_DATA_DIR=/data/data
# INFRAGEO_LOGS_DIR=/data/logs
# INFRAGEO_STORAGE_DIR=/data/storage
# LIMITE_ESTADUAL_DIR=/data/assets/LIMITE ESTADUAL
# LIMITE_ESTADUAL_SHP=/data/limite.shp
